# .env.example — copy this file to .env and fill in real values for local development.
# .env is in .gitignore and must never be committed.
# This app has no authentication and is not intended for public deployment as-is.

# SQL Server connection
# For Docker Compose local development, the host is the service name from compose.yaml.
DB_URL=jdbc:sqlserver://sqlserver:1433;databaseName=BookCrudDev;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa

# SQL Server password complexity rules:
#   - At least 8 characters
#   - Mix of uppercase, lowercase, digits, and special characters
#   - Example format: MyStr0ng!Pass (replace with your own value)
DB_PASSWORD=CHANGE_ME_strong_password_here

# SQL Server EULA
# The mcr.microsoft.com/mssql/server Docker image requires you to accept the
# SQL Server End User License Agreement. Set this to Y to confirm acceptance.
# See: https://hub.docker.com/_/microsoft-mssql-server
ACCEPT_EULA=Y

# SQL Server Docker image (used in compose.yaml)
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
